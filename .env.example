# Copy to .env.local for local dev, and set these in Vercel → Project → Settings → Environment Variables for production.

# Central Gemini key used by the Meson "free tier" (shared key, 20 req/day/IP,
# combined across all Meson models/providers). Required for /api/meson/* routes to work
# without a user-supplied key, and for the live availability check on
# /api/meson/models and the admin status page at /admin/meson.
GEMINI_API_KEY_SHARED=

# Central Mistral La Plateforme key, used the same way as GEMINI_API_KEY_SHARED
# above but for Meson entries backed by providerId "mistral" (see
# src/ai/meson/registry.config.ts). Same shared 20 req/day/IP quota — it's one
# combined counter across all Meson providers, not 20 per provider. Optional:
# if unset, Mistral-backed Meson entries report as unconfigured (503) instead
# of crashing, and Gemini keeps working normally.
MISTRAL_API_KEY=

# Vercel KV (native product) was sunset — provided now via the Upstash
# Marketplace integration instead. In your Vercel project: Storage tab →
# Browse Storage → "Upstash" → create a Redis database → connect to this
# project. That injects these two automatically (same var names as the old
# Vercel KV, so no code changes needed beyond the @upstash/redis client).
# Used for: the shared-key rate limiter, and Meson 6.0 video-generation job tracking.
KV_REST_API_URL=
KV_REST_API_TOKEN=
